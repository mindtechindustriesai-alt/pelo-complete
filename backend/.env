# PELO Backend - Local Development

ENVIRONMENT=development
DEBUG=true

# DeepSeek
DEEPSEEK_API_KEY=sk-your-actual-key-here

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=local-development-secret-do-not-use-in-production

# Firebase (optional for local)
FIREBASE_PROJECT_ID=mindflow-ai-education
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@mindflow-ai-education.iam.gserviceaccount.com

# CORS (for local frontend)
CORS_ORIGINS=http://localhost:5500,http://localhost:3000

# Emergency Numbers (SA)
GBV_HELPLINE=0800150150
GBV_SILENT_CALLBACK=0800428428
CHILDLINE_NUMBER=0800055555
SAPS_EMERGENCY=10111
